          <label class="fw-bold">LLM timeout (ms)</label>
          <input type="text" class="form-control" id="LLM_TIMEOUT_MS" value="${prefill.LLM_TIMEOUT_MS || ''}" placeholder="e.g. 15000">
        </div>

        <div class="d-flex justify-content-between mt-4">
          <button class="btn btn-outline-danger" onclick="skipOnboardingStep()">Will do later</button>
          <div>
            <button class="btn btn-outline-secondary" onclick="previousOnboardingStep()">Back</button>
            <button class="btn btn-primary" onclick="nextOnboardingStep()">Next</button>
          </div>
        </div>
      `;

        setTimeout(() => {
          if (isFreeEdition()) {

            // 1. Red warning notice
            const notice10 = document.getElementById("sleepEditionNotice10");
            if (notice10) {
              notice10.innerHTML = `
                <p style="color:#d9534f; font-weight:bold; margin-top:-10px; margin-bottom:15px;">
                  This feature is not available in your current version
                </p>
              `;
            }

            // 2. Prepare fields just like Step 8
            const sleepMode = document.getElementById("MEISleepMode"); // dropdown

            const wakeHour = document.getElementById("WAKE_UP_HOUR");
            const wakeMin = document.getElementById("WAKE_UP_MINS");
            const sleepHour = document.getElementById("SLEEP_HOUR");
            const sleepMin = document.getElementById("SLEEP_MINS");
            const llmTimeout = document.getElementById("LLM_TIMEOUT_MS");

            const disabledInputs = [wakeHour, wakeMin, sleepHour, sleepMin, llmTimeout];
            const disabledSelects = [sleepMode];

            // Disable text inputs (same as step 8)
            disabledInputs.forEach(el => {
              if (el) {
                el.disabled = true;
                el.value = "";
                el.placeholder = "(This feature is not available in your current version)";
                el.style.background = "#e9ecef";
                el.style.cursor = "not-allowed";
              }
            });

            // Disable dropdowns (same as step 8)
            disabledSelects.forEach(el => {
              if (el) {
                el.disabled = true;
                el.style.background = "#e9ecef";
                el.style.cursor = "not-allowed";
              }
            });

          }
        }, 40);

        
    } else if (currentStep === 9) {
      content.innerHTML = `
        <button onclick="closeOnboarding()" style="position:absolute;top:10px;right:10px;background:none;border:none;font-size:1.5rem;color:#888;">&times;</button>
