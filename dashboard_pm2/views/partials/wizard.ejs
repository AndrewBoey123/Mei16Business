        <p class="text-muted mb-4">Step 9 of 9</p>

        <div class="form-group mb-3">
          <label class="fw-bold">Dashboard Username</label>
          <input type="text" class="form-control" id="WEBDASHBOARD_USERNAME" value="${prefill.WEBDASHBOARD_USERNAME || ''}" placeholder="admin">
        </div>
        <div class="form-group mb-4">
          <label class="fw-bold">Dashboard Password</label>
          <input type="password" class="form-control" id="WEBDASHBOARD_PASSWORD" value="${prefill.WEBDASHBOARD_PASSWORD || ''}" placeholder="••••••••">
        </div>

        <div class="d-flex justify-content-between mt-4">
          <button class="btn btn-outline-danger" onclick="skipOnboardingStep()">Will do later</button>
          <div>
            <button class="btn btn-outline-secondary" onclick="previousOnboardingStep()">Back</button>
            <button class="btn btn-primary" onclick="nextOnboardingStep()">Save</button>
            <button class="btn btn-success" onclick="saveAndRebootServer()">Save & Reboot</button>
          </div>
        </div>
      `;
    } 
  }

  function closeOnboarding() {
    document.getElementById('onboardingModal').style.display = 'none';
    currentStep = 1;
  }

  async function saveAndRebootServer() {
    const stepData = {
      WEBDASHBOARD_USERNAME: document.getElementById('WEBDASHBOARD_USERNAME')?.value.trim() || '',
      WEBDASHBOARD_PASSWORD: document.getElementById('WEBDASHBOARD_PASSWORD')?.value.trim() || ''
    };

    try {
      // 1. Save FINAL step (Step 11)
      const saveRes = await fetch('/wizard/save/9', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(stepData)
      });

      if (!saveRes.ok) {
        alert('Failed to save settings.');
        return;
      }

      // 2. Confirm reboot
      const confirmReboot = confirm(
        'Settings saved successfully.\nDo you want to reboot the server now?'
      );
      if (!confirmReboot) {
        alert('Reboot cancelled. Settings saved.');
        closeOnboarding();
        return;
      }

      // 3. Disable button
      const btn = event?.target;
      if (btn) {
        btn.disabled = true;
        btn.innerText = 'Rebooting...';
      }

      // 4. Trigger reboot
      const rebootRes = await fetch('/api/app-control/reboot', {
        method: 'POST'
      });

      if (rebootRes.ok) {
        alert('Server is rebooting now. This page will disconnect shortly.');
        closeOnboarding();
      } else {
        alert('Failed to trigger reboot. Please reboot manually.');
      }

    } catch (err) {
      console.error('Save & Reboot error:', err);
      alert('Unexpected error while saving or rebooting.');
    }
  }
</script>

<script>
function handleLanguageSelect(value) {
  const wrapper = document.getElementById('languageWrapper');

  if (value === 'custom') {
    // prevent immediate re-trigger
    suppressCustomTrigger = true;

    wrapper.innerHTML = `
      <input type="text" class="form-control" id="localFormat"
             placeholder="Enter custom language code (e.g. pt-BR)"
             onblur="persistCustomLanguage(this.value)"
             onkeydown="if(event.key==='Enter'){persistCustomLanguage(this.value)}">
      <small class="text-muted d-block mt-1">
        Press Enter or click outside to confirm. 
        <a href="#" onclick="revertLanguageDropdown(); return false;">Back to list</a>
      </small>
    `;
  } else {
    // restore normal behavior
    suppressCustomTrigger = false;

    // ensure hidden field always exists
    let hidden = document.getElementById('localFormat');
    if (!hidden) {
      hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.id = 'localFormat';
      wrapper.appendChild(hidden);
    }
    hidden.value = value;
  }
}

function persistCustomLanguage(val) {
  const input = document.getElementById('localFormat');
  if (input) input.value = val.trim();
  suppressCustomTrigger = false; // re-enable future "Others" click
}

function revertLanguageDropdown() {
  suppressCustomTrigger = false; // ensure we can click again
  const wrapper = document.getElementById('languageWrapper');
  const prefillValue = document.getElementById('localFormat')?.value || 'en-US';

  // restore the dropdown without re-rendering full page
  wrapper.innerHTML = `
    <select class="form-select" id="languageSelect"
            onchange="handleLanguageSelect(this.value)"
            onclick="if(this.value==='custom' && !suppressCustomTrigger){handleLanguageSelect('custom')}">
      <option value="en-US" ${prefillValue === 'en-US' ? 'selected' : ''}>English (United States)</option>
      <option value="en-GB" ${prefillValue === 'en-GB' ? 'selected' : ''}>English (United Kingdom)</option>
      <option value="ms-MY" ${prefillValue === 'ms-MY' ? 'selected' : ''}>Malay (Malaysia)</option>
      <option value="zh-CN" ${prefillValue === 'zh-CN' ? 'selected' : ''}>Chinese (Simplified)</option>
      <option value="zh-TW" ${prefillValue === 'zh-TW' ? 'selected' : ''}>Chinese (Traditional)</option>
      <option value="ja-JP" ${prefillValue === 'ja-JP' ? 'selected' : ''}>Japanese</option>
      <option value="ko-KR" ${prefillValue === 'ko-KR' ? 'selected' : ''}>Korean</option>
      <option value="fr-FR" ${prefillValue === 'fr-FR' ? 'selected' : ''}>French</option>
      <option value="de-DE" ${prefillValue === 'de-DE' ? 'selected' : ''}>German</option>
      <option value="es-ES" ${prefillValue === 'es-ES' ? 'selected' : ''}>Spanish</option>
      <option value="it-IT" ${prefillValue === 'it-IT' ? 'selected' : ''}>Italian</option>
      <option value="id-ID" ${prefillValue === 'id-ID' ? 'selected' : ''}>Indonesian</option>
      <option value="th-TH" ${prefillValue === 'th-TH' ? 'selected' : ''}>Thai</option>
      <option value="vi-VN" ${prefillValue === 'vi-VN' ? 'selected' : ''}>Vietnamese</option>
      <option value="hi-IN" ${prefillValue === 'hi-IN' ? 'selected' : ''}>Hindi</option>
      <option value="custom">Others..</option>
    </select>
  `;

  // restore hidden input
  const hidden = document.createElement('input');
  hidden.type = 'hidden';
  hidden.id = 'localFormat';
  hidden.value = prefillValue;
  wrapper.appendChild(hidden);
}

</script>

