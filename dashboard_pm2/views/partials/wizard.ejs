        <div class="form-group mb-3">
          <label class="fw-bold">Typing duration (min sec)</label>
          <input type="text" class="form-control" id="TYPING_DURATION_MIN_SEC" value="${prefill.TYPING_DURATION_MIN_SEC || ''}" placeholder="e.g. 3">
        </div>
        <div class="form-group mb-3">
          <label class="fw-bold">Typing duration (max sec)</label>
          <input type="text" class="form-control" id="TYPING_DURATION_MAX_SEC" value="${prefill.TYPING_DURATION_MAX_SEC || ''}" placeholder="e.g. 5">
