<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest"></script>
<script>
  // Wait until all DOM is ready before replacing <i data-lucide="">
  document.addEventListener('DOMContentLoaded', function() {
    lucide.createIcons();
  });
</script>
<script>
  function openN8N() {
    const protocol = window.location.protocol;
    const hostname = window.location.hostname;
    const port = window.location.port;

    if (!port) return alert("No port detected in URL!");

    let portStr = port.toString();

    // If port is only 1 digit, nothing to replace
    if (portStr.length < 2) {
      return alert("Port too short to modify.");
    }

    // Replace ONLY the second digit with '2'
    const newPortStr = portStr[0] + "2" + portStr.slice(2);

    const url = `${protocol}//${hostname}:${newPortStr}/`;
    window.open(url, "_blank");
  }
</script>

<script>
(function () {
  try {
    const hostname = window.location.hostname;

    let logoUrl = "/assets/logo.png";

    // Ignore official domains
    if (!hostname.endsWith("mei.trading") && !hostname.endsWith("meibot.cloud") && hostname !== "localhost") {
      const parts = hostname.split(".");
      if (parts.length >= 2) {
        const baseDomain = parts.slice(-2).join(".");
        logoUrl = `https://${baseDomain}/img/dashboard/botlogo.png`;
      }
    }

    const img = document.getElementById("navLogo");
    if (!img) return;

    img.onerror = () => {
      img.src = "/assets/logo.png";
    };

    img.src = logoUrl;
  } catch (_) {
    // silent fail
  }
})();
</script>




