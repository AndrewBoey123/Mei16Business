<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mei Admin Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background-color: #f8f9fa;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
    }

    .login-card {
      width: 100%;
      max-width: 300px;
      min-height: 500px;
      border: none;
      border-radius: 15px;
      box-shadow: 0 0 30px rgba(0, 0, 0, 0.15);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .login-header {
      background-color: #23A6C0;
      color: white;
      border-radius: 15px 15px 0 0 !important;
      text-align: center;
      padding: 2rem 1rem 1.2rem 1rem;
    }

    .logo-login {
      max-width: 120px;
      margin-bottom: 10px;
    }

    .btn-login {
      background-color: #23A6C0;
      border-color: #23A6C0;
      color: white;
      transition: background-color 0.2s ease;
    }

    .btn-login:hover {
      background-color: #1c879b;
      border-color: #1c879b;
      color: white;
    }

    .login-form {
      padding: 2.5rem 2rem;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .form-label {
      font-weight: 500;
    }

    .alert {
      font-size: 0.95rem;
    }
  </style>
</head>

<body>
  <div class="card login-card">
    <div class="login-header">
      <img id="loginLogo" src="/assets/logo.png" alt="Dashboard Logo" class="logo-login">
      <h4 style="font-size: 1.4rem"><%= BOT_NAME %> Dashboard</h4>
    </div>
    <div class="login-form">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input type="text" class="form-control" id="username" name="username" required autofocus>
        </div>
        <div class="mb-4">
          <label for="password" class="form-label">Password</label>
          <input type="password" class="form-control" id="password" name="password" required>
        </div>

        <button type="submit" class="btn btn-login w-100 py-2 mt-3">Login</button>

        <input type="hidden" name="dashboardPort" id="dashboardPort">
      </form>

          </div>
    </div>
  </div>


<script>
(function () {
  try {
    const hostname = window.location.hostname; 
    // example: bot.worknova.xyz

    // Default = local logo
    let logoUrl = "/assets/logo.png";

    // Ignore official domains
    if (!hostname.endsWith("mei.trading") && !hostname.endsWith("meibot.cloud")) {
      const parts = hostname.split(".");
      if (parts.length >= 2) {
        const baseDomain = parts.slice(-2).join(".");
        logoUrl = `https://${baseDomain}/img/dashboard/botlogo.png`;
      }
    }

    const img = document.getElementById("loginLogo");
    if (!img) return;

    img.onerror = () => {
      img.src = "/assets/logo.png";
    };

    img.src = logoUrl;
  } catch (e) {
    // silent fail → keep default logo
  }
})();
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const port = window.location.port || "443";
  const input = document.getElementById("dashboardPort");
  if (input) input.value = port;
});
</script>



</body>
</html>
