



<!-- THIS PAGE ALLOWS THE INSTALLING OF LATEST WHATSAPP-WEB & PUPPETEER -->

<%- include('partials/header') %>

<div class="container mt-4">
  <h3>Install / Update Packages <span style="color:#dc3545;">(WARNING: Use only if you know what you are doing!)</span></h3>
  <p class="text-muted">This will update the latest Whatsapp Open Source libraries on your Linux cloud server.</code></p>
  

  <div class="card">
    <div class="card-body">
      <button id="btnRun" class="btn btn-primary mb-3">
        <i class="fa fa-play"></i> Run Install
      </button>
      <span id="state" class="text-muted"></span>

      <!-- Output text here -->
      <div id="log" class="mt-3" style="white-space: pre-line; font-family: 'Poppins', sans-serif; font-size: 0.9rem; color: #333;">
        <!-- npm output will show here -->
      </div>
    </div>
  </div>
</div>

<script>
  const btn = document.getElementById('btnRun');
  const logEl = document.getElementById('log');
  const stateEl = document.getElementById('state');

  function append(t){ logEl.textContent += t; }

  btn.addEventListener('click', async () => {
    btn.disabled = true;
    stateEl.textContent = 'Running…';
    logEl.textContent = '';

    try {
      const res = await fetch('/api/install', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });

      if (!res.ok) {
        append('\n[HTTP ' + res.status + '] ' + (await res.text()));
        stateEl.textContent = 'Failed (HTTP error)';
        btn.disabled = false;
        return;
      }

      const data = await res.json();
      append(data.output || '');
      stateEl.textContent = data.success ? 'Completed successfully.' : ('Exited with code ' + data.code);
    } catch (e) {
      append('\n' + (e && e.message ? e.message : String(e)));
      stateEl.textContent = 'Failed (network/exception)';
    } finally {
      btn.disabled = false;
    }
  });
</script>

<%- include('partials/footer') %>
