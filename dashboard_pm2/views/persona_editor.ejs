<%- include('partials/header') %>

<div class="d-flex">
  <div class="sidebar bg-dark text-white">
    <%- include('partials/sidebar') %>
  </div>

  <div class="main-content p-4 flex-grow-1">
    <div class="card shadow mb-4">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Persona Editor</h5>
      </div>

      <div class="card-body">
        <!-- Nav tabs -->
        <ul class="nav nav-tabs mb-3" id="personaTabs">
          <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" data-tab="short" href="#short">Brief</a></li>
          <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" data-tab="long" href="#long">One-To-One Chat</a></li>
          <li class="nav-item"><a class="nav-link" id="tab-group" data-bs-toggle="tab" data-tab="group" href="#group">Group Chat</a></li>
          <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" data-tab="reporter" href="#reporter">Boss Chat</a></li>
        </ul>

        <% if (typeof success !== 'undefined') { %>
          <div class="alert alert-success">✅ Persona saved successfully!</div>
        <% } %>

        <!-- Tab panes -->
        <form method="POST" action="/persona-editor">
          <div class="tab-content">
            <div class="tab-pane fade show active" id="short">
              <textarea name="short" class="form-control font-monospace" rows="20"><%= data.short %></textarea>
            </div>
            <div class="tab-pane fade" id="long">
              <textarea name="long" class="form-control font-monospace" rows="20"><%= data.long %></textarea>
            </div>
            <div class="tab-pane fade" id="group">
              <textarea name="group" class="form-control font-monospace" rows="20"><%= data.group %></textarea>
            </div>
            <div class="tab-pane fade" id="reporter">
              <textarea name="reporter" class="form-control font-monospace" rows="20"><%= data.reporter %></textarea>
            </div>
          </div>

          <div class="d-flex justify-content-end mt-3">
            <button type="submit" class="btn btn-success float-end"><i class="fas fa-save me-1 text-white"></i> Save
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
// Open source edition - all features enabled
function getEffectiveEdition() {
  return "opensource";
}

// All persona features enabled for open source
document.addEventListener("DOMContentLoaded", () => {
  // No restrictions - all tabs editable
});
</script>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const edition = localStorage.getItem("MEI_EDITION") || "business";
  const saveBtn = document.querySelector('button[type="submit"]');

  function updateSaveButton(activeTab) {
    if (!saveBtn) return;

    const blocked =
      (edition === "free" && activeTab === "group");

    if (blocked) {
      saveBtn.disabled = true;
      saveBtn.classList.add("btn-secondary");
      saveBtn.classList.remove("btn-success");
      saveBtn.innerHTML = `<i class="fas fa-ban me-1 text-white"></i> Save`;
    } else {
      saveBtn.disabled = false;
      saveBtn.classList.remove("btn-secondary");
      saveBtn.classList.add("btn-success");
      saveBtn.innerHTML = `<i class="fas fa-save me-1 text-white"></i> Save`;
    }
  }

  document.querySelectorAll('#personaTabs .nav-link').forEach(tab => {
    tab.addEventListener('shown.bs.tab', e => {
      updateSaveButton(e.target.getAttribute("data-tab"));
    });
  });

  updateSaveButton("short");
});
</script>





<%- include('partials/footer') %>
