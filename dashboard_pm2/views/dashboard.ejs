<script>
  function finishGuide() {
    // stop youtube
    const yt = document.getElementById('ytGuideFrame');
    if (yt) yt.src = yt.src;

    const modal = document.getElementById('guideModal');
    if (modal) modal.style.display = 'none';

    const dontShow = document.getElementById('dontShowGuide')?.checked;

    if (dontShow) {
      fetch('/guide/complete', { method: 'POST' })
        .then(() => {
          const wizardButton = document.getElementById('wizardTrigger');
          if (wizardButton) setTimeout(() => wizardButton.click(), 200);
        });
    } else {
      const wizardButton = document.getElementById('wizardTrigger');
      if (wizardButton) setTimeout(() => wizardButton.click(), 200);
    }
  }

  function closeGuide() {
    // stop youtube
    const yt = document.getElementById('ytGuideFrame');
    if (yt) yt.src = yt.src;

    const modal = document.getElementById('guideModal');
    if (modal) modal.style.display = 'none';

    const dontShow = document.getElementById('dontShowGuide')?.checked;

    if (dontShow) {
      fetch('/guide/complete', { method: 'POST' })
        .then(() => {
          const wizardButton = document.getElementById('wizardTrigger');
          if (wizardButton) setTimeout(() => wizardButton.click(), 300);
        });
    } else {
      const wizardButton = document.getElementById('wizardTrigger');
      if (wizardButton) setTimeout(() => wizardButton.click(), 300);
    }
  }
</script>

<script>
function detectEditionFromFolderName(version) {
  if (!version) return "free";

  const v = version.toLowerCase();

  if (v.includes("free")) return "free";
  if (v.includes("business")) return "business";
  if (v.includes("enterprise")) return "enterprise";

  // plain Mei16 / Mei17 → business
  if (v.startsWith("mei") && /\d/.test(v)) return "business";

  return "free";
}
</script>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const version = localStorage.getItem("mei_selected_version") || "";
  const edition = detectEditionFromFolderName(version);

  const VIDEO_LINKS = {
    free: "https://my.mei.trading/GettingStartedCloud",
    business: "https://my.mei.trading/GettingStartedBusiness",
    enterprise: "https://my.mei.trading/GettingStartedEnterprise"
  };

  const yt = document.getElementById("ytGuideFrame");
  if (yt) yt.src = VIDEO_LINKS[edition] || VIDEO_LINKS.enterprise;
});
</script>






