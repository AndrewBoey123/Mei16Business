<!-- Toast Container -->
<div class="fm-toast-container" id="toastContainer"></div>

<!-- Upload Progress -->
<div class="fm-upload-progress" id="uploadProgress">
  <div class="fm-upload-header">
    <span>Uploading...</span>
    <span id="uploadPercent">0%</span>
  </div>
  <div class="fm-upload-bar">
    <div class="fm-upload-fill" id="uploadFill" style="width:0%"></div>
  </div>
  <div id="uploadBytes" style="font-size:11px; margin-top:5px; color:var(--fm-muted);"></div>
  <div id="uploadCurrentFile" style="font-size:11px; margin-top:3px; color:var(--fm-muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></div>
</div>

<!-- Copy / Move Progress & Verification -->
<div class="fm-upload-progress" id="copyProgress">
  <div class="fm-upload-header">
    <span id="copyProgressTitle">📋 Copying...</span>
    <span id="copyProgressPercent"></span>
  </div>
  <div class="fm-upload-bar fm-bar-pulse" id="copyProgressBar">
    <div class="fm-upload-fill" id="copyProgressFill" style="width:0%; transition:none;"></div>
  </div>
  <div id="copyProgressBytes" style="font-size:11px; margin-top:5px; color:var(--fm-muted);"></div>
  <div id="copyProgressList" style="display:none; margin-top:8px; max-height:200px; overflow-y:auto;"></div>
  <div id="copyProgressSummary" style="display:none; margin-top:6px; font-size:12px; font-weight:600;"></div>
  <div id="copyProgressActions" style="display:none; margin-top:10px; text-align:right; gap:8px;"></div>
</div>

<script>
// ========================================
// FILE MANAGER PRO - JAVASCRIPT
// ========================================

// ───── Byte formatting helper ─────
function formatBytes(bytes) {
  if (!bytes && bytes !== 0) return '—';
  if (bytes === 0) return '0 B';
  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
  return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
}

// ───── Copy / Move progress widget ─────
function showCopyProgress(opts) {
  const el       = document.getElementById('copyProgress');
  const titleEl  = document.getElementById('copyProgressTitle');
  const pctEl    = document.getElementById('copyProgressPercent');
  const barEl    = document.getElementById('copyProgressBar');
  const fillEl   = document.getElementById('copyProgressFill');
  const bytesEl  = document.getElementById('copyProgressBytes');
  const listEl   = document.getElementById('copyProgressList');
  const summaryEl= document.getElementById('copyProgressSummary');
  const actionsEl= document.getElementById('copyProgressActions');
  const uploadEl = document.getElementById('uploadProgress');

  if (opts.state === 'copying') {
    // Stack above upload widget if it's visible
    el.classList.toggle('stacked', uploadEl && uploadEl.classList.contains('visible'));
    titleEl.textContent  = opts.action === 'move' ? '✂️ Moving...' : '📋 Copying...';
    pctEl.textContent    = '';
    bytesEl.textContent  = `${opts.total} item${opts.total !== 1 ? 's' : ''}...`;
    barEl.classList.add('fm-bar-pulse');
    fillEl.style.width   = '0%';
    listEl.style.display = 'none';
    listEl.innerHTML     = '';
    summaryEl.style.display  = 'none';
    actionsEl.style.display  = 'none';
    el.classList.add('visible');
    return;
  }

  if (opts.state === 'done') {
    const data = opts.data;
    const v    = data.verification;
    const isMove = opts.action === 'move';

    barEl.classList.remove('fm-bar-pulse');
    fillEl.style.width  = '100%';
    fillEl.style.transition = 'width 0.4s';

    if (!v) {
      // No verification data (move operation or error)
      const success = data.results ? data.results.filter(r => r.success).length : 0;
      const total   = data.results ? data.results.length : 0;
      titleEl.textContent = success === total
        ? `✅ ${isMove ? 'Move' : 'Copy'} Complete`
        : `⚠️ ${isMove ? 'Move' : 'Copy'} Incomplete`;
      bytesEl.textContent = `${success} of ${total} items`;
      pctEl.textContent   = '';
      actionsEl.innerHTML = '<button class="fm-btn fm-btn-primary" style="font-size:12px; padding:4px 12px;" onclick="document.getElementById(\'copyProgress\').classList.remove(\'visible\')">Close</button>';
      actionsEl.style.display = 'flex';
      actionsEl.style.justifyContent = 'flex-end';
      
      // Auto-close after 5 seconds
      setTimeout(() => {
        el.classList.remove('visible');
      }, 5000);
      return;
    }

    const allOk = v.verified;
    titleEl.textContent = allOk ? '✅ Copy Complete' : '⚠️ Copy Incomplete';
    pctEl.textContent   = '100%';

    const srcFmt = formatBytes(v.totalSrcBytes);
    const dstFmt = formatBytes(v.totalDstBytes);
    bytesEl.innerHTML = allOk
      ? `${dstFmt} / ${srcFmt} <span style="color:#28a745">✅ Verified</span>`
      : `${dstFmt} / ${srcFmt} <span style="color:#dc3545">❌ Mismatch</span>`;

    // Build per-file list
    if (v.files && v.files.length) {
      let html = '<ul class="fm-verify-list">';
      for (const f of v.files) {
        if (f.error) {
          html += `<li>
            <span class="fm-vi-fail">❌</span>
            <span class="fm-vi-name" title="${f.name}">${f.name}</span>
            <span class="fm-vi-fail" style="font-size:11px">${f.error}</span>
          </li>`;
        } else if (f.isFolder) {
          const ok = f.verified;
          html += `<li>
            <span class="${ok ? 'fm-vi-ok' : 'fm-vi-fail'}">${ok ? '✅' : '❌'}</span>
            <span class="fm-vi-name" title="${f.name}">📁 ${f.name}</span>
            <span class="fm-vi-size">${formatBytes(f.dstSize)}${!ok ? ' / ' + formatBytes(f.srcSize) : ''}</span>
            <span class="${ok ? 'fm-vi-ok' : 'fm-vi-fail'}">${ok ? '✓' : '✗'}</span>
          </li>`;
        } else {
          const ok = f.verified;
          html += `<li>
            <span class="${ok ? 'fm-vi-ok' : 'fm-vi-fail'}">${ok ? '✅' : '❌'}</span>
            <span class="fm-vi-name" title="${f.name}">${f.name}</span>
            <span class="fm-vi-size">${formatBytes(f.dstSize)}${!ok ? ' / ' + formatBytes(f.srcSize) : ''}</span>
            <span class="${ok ? 'fm-vi-ok' : 'fm-vi-fail'}">${ok ? '✓' : '✗'}</span>
          </li>`;
        }
      }
      html += '</ul>';
      listEl.innerHTML     = html;
      listEl.style.display = 'block';
    }

    // Summary line
    const failCount = v.files ? v.files.filter(f => !f.verified).length : 0;
    summaryEl.style.display = 'block';
    summaryEl.innerHTML = allOk
      ? `<span style="color:#28a745">${v.files ? v.files.length : ''} files • ${srcFmt} • 100% integrity ✓</span>`
      : `<span style="color:#dc3545">⚠️ ${failCount} file${failCount !== 1 ? 's' : ''} failed verification</span>`;

    // Actions
    actionsEl.innerHTML = '';
    actionsEl.style.display = 'flex';
    actionsEl.style.justifyContent = 'flex-end';
    actionsEl.style.gap = '8px';
    actionsEl.style.removeProperty('display'); // override inline display:none
    actionsEl.style.display = 'flex';

    const closeBtn = document.createElement('button');
    closeBtn.className = 'fm-btn';
    closeBtn.style.cssText = 'font-size:12px; padding:4px 12px;';
    closeBtn.textContent = 'Close';
    closeBtn.onclick = () => el.classList.remove('visible');
    actionsEl.appendChild(closeBtn);
    
    // Auto-close after 5 seconds if all OK
    if (allOk) {
      setTimeout(() => {
        el.classList.remove('visible');
      }, 5000);
    }
    return;
  }

  if (opts.state === 'hide') {
    el.classList.remove('visible');
  }
}

// State
let currentPath = '';
let currentItems = [];
let selectedItems = new Set();
let showHidden = false;

function toggleHidden() {
  showHidden = !showHidden;
  const btn = document.getElementById('toggleHiddenBtn');
  if (btn) {
    btn.classList.toggle('fm-btn-active', showHidden);
    btn.title = showHidden ? 'Hide hidden files and folders' : 'Show hidden files and folders';
    btn.innerHTML = showHidden
      ? '<i class="fa fa-eye"></i>'
      : '<i class="fa fa-eye-slash"></i>';
  }
  loadFolderTree();
  loadFiles(currentPath);
}
let viewMode = 'grid'; // 'grid' or 'list'
let clipboard = { items: [], action: null }; // action: 'copy' or 'cut'
let contextItem = null;
let currentPreviewItem = null;
let isSearching = false;

// DOM Elements
const els = {
  fileGrid: document.getElementById('fileGrid'),
  fileList: document.getElementById('fileList'),
  folderTree: document.getElementById('folderTree'),
  breadcrumb: document.getElementById('breadcrumb'),
  dropZone: document.getElementById('dropZone'),
  emptyState: document.getElementById('emptyState'),
  contextMenu: document.getElementById('contextMenu'),
  itemCount: document.getElementById('itemCount'),
  selectedCount: document.getElementById('selectedCount'),
  btnPaste: document.getElementById('btnPaste'),
  btnDownload: document.getElementById('btnDownload'),
  btnDelete: document.getElementById('btnDelete'),
  btnZip: document.getElementById('btnZip'),
  btnUp: document.getElementById('btnUp'),
  sidebar: document.getElementById('sidebar'),
  sidebarOverlay: document.getElementById('sidebarOverlay'),
};

// Icon Map
const iconMap = {
  folder: { icon: 'fa-folder', color: '#ffc107' },
  image: { icon: 'fa-file-image', color: '#9c27b0' },
  video: { icon: 'fa-file-video', color: '#f44336' },
  audio: { icon: 'fa-file-audio', color: '#2196f3' },
  pdf: { icon: 'fa-file-pdf', color: '#ff5722' },
  word: { icon: 'fa-file-word', color: '#2196f3' },
  excel: { icon: 'fa-file-excel', color: '#4caf50' },
  powerpoint: { icon: 'fa-file-powerpoint', color: '#ff9800' },
  code: { icon: 'fa-file-code', color: '#607d8b' },
  zip: { icon: 'fa-file-zipper', color: '#795548' },
  text: { icon: 'fa-file-alt', color: '#9e9e9e' },
  file: { icon: 'fa-file', color: '#757575' },
};

// Initialize
async function init() {
  // Load saved view mode
  const savedView = localStorage.getItem('fm_viewMode');
  if (savedView) viewMode = savedView;
  updateViewMode();

  // Load initial data
  await Promise.all([
    loadFolderTree(),
    loadFiles()
  ]);

  // Setup event listeners
  setupDragDrop();
  setupKeyboard();
  setupContextMenu();
  setupClipboardPaste();

  // Check URL params for path
  const urlParams = new URLSearchParams(window.location.search);
  const pathParam = urlParams.get('dir');
  if (pathParam) {
    navigateTo(decodeURIComponent(pathParam));
  }
}

// Load Folder Tree
async function loadFolderTree() {
  try {
    const res = await fetch('/fileman/api/tree?dir=&showHidden=' + showHidden);
    const data = await res.json();
    
    if (!data.ok) throw new Error(data.error);

    els.folderTree.innerHTML = `
      <div class="fm-tree-item ${!currentPath ? 'active' : ''}" onclick="navigateTo('')">
        <span class="fm-tree-toggle" style="visibility:hidden;"><i class="fa fa-chevron-right"></i></span>
        <i class="fa fa-hdd" style="color:var(--fm-primary);"></i>
        <span>Root</span>
      </div>
      ${renderTreeItems(data.dirs, '')}
    `;
  } catch (err) {
    showToast('Error loading folders: ' + err.message, 'error');
  }
}

function renderTreeItems(dirs, parentPath) {
  if (!dirs || dirs.length === 0) return '';
  
  return `<div class="fm-tree-children expanded" data-parent="${parentPath}">
    ${dirs.map(dir => `
      <div class="fm-tree-item ${currentPath === dir.rel ? 'active' : ''}" data-path="${dir.rel}">
        <span class="fm-tree-toggle" onclick="event.stopPropagation(); toggleTreeFolder('${dir.rel}', this)">
          <i class="fa fa-chevron-right"></i>
        </span>
        <i class="fa fa-folder"></i>
        <span onclick="navigateTo('${dir.rel}')">${escapeHtml(dir.name)}</span>
      </div>
      <div class="fm-tree-children" id="tree-${dir.rel.replace(/[^a-zA-Z0-9]/g, '-')}"></div>
    `).join('')}
  </div>`;
}

async function toggleTreeFolder(path, toggleEl) {
  const container = document.getElementById('tree-' + path.replace(/[^a-zA-Z0-9]/g, '-'));
  const isExpanded = container.classList.contains('expanded');
  
  if (isExpanded) {
    container.classList.remove('expanded');
    toggleEl.classList.remove('expanded');
    toggleEl.innerHTML = '<i class="fa fa-chevron-right"></i>';
  } else {
    // Load children if empty
    if (!container.dataset.loaded) {
      try {
        const res = await fetch('/fileman/api/tree?dir=' + encodeURIComponent(path) + '&showHidden=' + showHidden);
        const data = await res.json();
        if (data.ok && data.dirs.length > 0) {
          container.innerHTML = renderTreeItems(data.dirs, path);
        }
        container.dataset.loaded = 'true';
      } catch (err) {
        console.error('Error loading tree:', err);
      }
    }
    container.classList.add('expanded');
    toggleEl.classList.add('expanded');
    toggleEl.innerHTML = '<i class="fa fa-chevron-down"></i>';
  }
}

// Load Files
async function loadFiles() {
  if (isSearching) return;

  try {
    showLoading(true);
    const res = await fetch('/fileman/api/list?dir=' + encodeURIComponent(currentPath) + '&showHidden=' + showHidden);
    const data = await res.json();
    
    if (!data.ok) throw new Error(data.error);

    currentItems = data.items || [];
    renderFiles();
    updateBreadcrumb(data.currentPath, data.parentPath);
    updateStatus();
    
    // Update Up button
    els.btnUp.disabled = !data.parentPath && data.parentPath !== '';
  } catch (err) {
    showToast('Error loading files: ' + err.message, 'error');
  } finally {
    showLoading(false);
  }
}

function renderFiles() {
  // Clear selection
  selectedItems.clear();
  updateSelectionUI();

  if (currentItems.length === 0) {
    els.fileGrid.style.display = 'none';
    els.fileList.style.display = 'none';
    els.emptyState.style.display = 'flex';
    return;
  }

  els.emptyState.style.display = 'none';

  if (viewMode === 'grid') {
    renderGrid();
  } else {
    renderList();
  }
}

function renderGrid() {
  els.fileGrid.style.display = 'grid';
  els.fileList.style.display = 'none';

  els.fileGrid.innerHTML = currentItems.map(item => {
    const iconInfo = iconMap[item.icon] || iconMap.file;
    const isImage = item.icon === 'image';
    
    return `
      <div class="fm-grid-item" 
           data-path="${item.path}" 
           data-folder="${item.type === 'folder'}"
           onclick="handleItemClick(event, '${item.path}', ${item.type === 'folder'})"
           ondblclick="handleItemDblClick('${item.path}', ${item.type === 'folder'})"
           oncontextmenu="handleItemContextMenu(event, '${item.path}', ${item.type === 'folder'}, '${item.icon}')">
        <div class="fm-grid-icon ${item.icon}">
          ${isImage && item.previewable ? `<img src="/fileman/api/download?path=${encodeURIComponent(item.path)}" loading="lazy" onerror="this.outerHTML='<i class=\\'fa ${iconInfo.icon}\\' style=\\'color:${iconInfo.color}\\'></i>'">` : `<i class="fa ${iconInfo.icon}" style="color:${iconInfo.color}"></i>`}
        </div>
        <div class="fm-grid-name" title="${escapeHtml(item.name)}">${escapeHtml(item.name)}</div>
      </div>
    `;
  }).join('');
}

function renderList() {
  els.fileGrid.style.display = 'none';
  els.fileList.style.display = 'block';

  els.fileList.innerHTML = `
    <div class="fm-list-header">
      <div><input type="checkbox" onchange="toggleSelectAll(this.checked)"></div>
      <div>Name</div>
      <div>Size</div>
      <div>Modified</div>
      <div></div>
    </div>
    ${currentItems.map(item => {
      const iconInfo = iconMap[item.icon] || iconMap.file;
      return `
        <div class="fm-list-item" 
             data-path="${item.path}" 
             data-folder="${item.type === 'folder'}"
             onclick="handleItemClick(event, '${item.path}', ${item.type === 'folder'})"
             ondblclick="handleItemDblClick('${item.path}', ${item.type === 'folder'})"
             oncontextmenu="handleItemContextMenu(event, '${item.path}', ${item.type === 'folder'}, '${item.icon}')">
          <div class="fm-list-checkbox" onclick="event.stopPropagation()">
            <input type="checkbox" onchange="toggleItemSelection('${item.path}', this.checked)">
          </div>
          <div class="fm-list-name">
            <i class="fa ${iconInfo.icon} ${item.icon}"></i>
            <span>${escapeHtml(item.name)}</span>
          </div>
          <div class="fm-list-size">${item.type === 'folder' ? item.itemCount + ' items' : formatSize(item.size)}</div>
          <div class="fm-list-date">${formatDate(item.modified)}</div>
          <div class="fm-list-actions">
            <button onclick="event.stopPropagation(); downloadItem('${item.path}', ${item.type === 'folder'})" title="Download"><i class="fa fa-download"></i></button>
            <button onclick="event.stopPropagation(); showRenameModal('${item.path}', ${item.type === 'folder'})" title="Rename"><i class="fa fa-edit"></i></button>
            <button onclick="event.stopPropagation(); deleteItems([{path:'${item.path}',isFolder:${item.type === 'folder'}}])" title="Delete"><i class="fa fa-trash"></i></button>
          </div>
        </div>
      `;
    }).join('')}
  `;
}

// Navigation
function navigateTo(path) {
  currentPath = path;
  
  // Update URL
  const url = new URL(window.location);
  if (path) {
    url.searchParams.set('dir', path);
  } else {
    url.searchParams.delete('dir');
  }
  window.history.replaceState({}, '', url);

  // Update tree selection
  document.querySelectorAll('.fm-tree-item').forEach(el => {
    el.classList.toggle('active', el.dataset.path === path || (!path && !el.dataset.path));
  });

  loadFiles();
}

function goUp() {
  if (!currentPath) return;
  const parent = currentPath.includes('/') ? currentPath.substring(0, currentPath.lastIndexOf('/')) : '';
  navigateTo(parent);
}

function refresh() {
  loadFolderTree();
  loadFiles();
}

function updateBreadcrumb(path, parentPath) {
  const parts = path ? path.split('/') : [];
  let html = `
    <div class="fm-breadcrumb-item" onclick="navigateTo('')">
      <i class="fa fa-home"></i> Home
    </div>
  `;

  let currentBuildPath = '';
  parts.forEach((part, index) => {
    currentBuildPath = currentBuildPath ? `${currentBuildPath}/${part}` : part;
    const isLast = index === parts.length - 1;
    html += `<span class="fm-breadcrumb-separator"><i class="fa fa-chevron-right"></i></span>`;
    html += `
      <div class="fm-breadcrumb-item ${isLast ? 'fm-breadcrumb-current' : ''}" onclick="${isLast ? '' : `navigateTo('${currentBuildPath}')`}">
        ${escapeHtml(part)}
      </div>
    `;
  });

  els.breadcrumb.innerHTML = html;
}

// View Mode
function setViewMode(mode) {
  viewMode = mode;
  localStorage.setItem('fm_viewMode', mode);
  updateViewMode();
  renderFiles();
}

function updateViewMode() {
  document.getElementById('btnGrid').classList.toggle('active', viewMode === 'grid');
  document.getElementById('btnList').classList.toggle('active', viewMode === 'list');
  document.getElementById('viewModeLabel').textContent = viewMode === 'grid' ? 'Grid View' : 'List View';
}

// Selection
function handleItemClick(event, path, isFolder) {
  // Handle Ctrl/Cmd click for multi-select
  if (event.ctrlKey || event.metaKey) {
    event.preventDefault();
    toggleItemSelection(path, !selectedItems.has(path));
    return;
  }

  // Regular click - single select
  if (!event.shiftKey) {
    selectedItems.clear();
    selectedItems.add(path);
    updateSelectionUI();
  }
}

function handleItemDblClick(path, isFolder) {
  if (isFolder) {
    navigateTo(path);
  } else {
    previewFile(path, true);
  }
}

function toggleItemSelection(path, selected) {
  if (selected) {
    selectedItems.add(path);
  } else {
    selectedItems.delete(path);
  }
  updateSelectionUI();
}

function toggleSelectAll(checked) {
  if (checked) {
    currentItems.forEach(item => selectedItems.add(item.path));
  } else {
    selectedItems.clear();
  }
  updateSelectionUI();
}

function updateSelectionUI() {
  // Update grid/list item styling
  document.querySelectorAll('.fm-grid-item, .fm-list-item').forEach(el => {
    const path = el.dataset.path;
    el.classList.toggle('selected', selectedItems.has(path));
    
    // Update checkbox in list view
    const checkbox = el.querySelector('input[type="checkbox"]');
    if (checkbox) checkbox.checked = selectedItems.has(path);
  });

  // Update toolbar buttons
  const hasSelection = selectedItems.size > 0;
  els.btnDownload.disabled = !hasSelection;
  els.btnDelete.disabled = !hasSelection;
  els.btnZip.disabled = !hasSelection;

  // Update status bar
  els.selectedCount.style.display = hasSelection ? 'inline' : 'none';
  els.selectedCount.textContent = `${selectedItems.size} selected`;
}

// Context Menu
function setupContextMenu() {
  document.addEventListener('click', () => {
    els.contextMenu.classList.remove('visible');
  });

  // Right-click on blank area of the content pane
  document.getElementById('contentArea').addEventListener('contextmenu', (event) => {
    // Only fire when the click target is the content area itself or the drop zone — not a file/folder item
    if (event.target.closest('[oncontextmenu]')) return;
    event.preventDefault();
    showBackgroundContextMenu(event);
  });
}

function showBackgroundContextMenu(event) {
  contextItem = null;

  // Show background-only items
  ['ctxNew', 'ctxSortBy', 'ctxDividerBg'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = 'flex';
  });
  document.getElementById('ctxDividerBg').style.display = 'block';
  document.getElementById('ctxPasteBg').style.display = 'flex';

  // Hide item-specific options
  ['ctxOpen', 'ctxPreview', 'ctxDownload', 'ctxRename', 'ctxCopy', 'ctxCut', 'ctxPaste',
   'ctxZip', 'ctxUnzip', 'ctxDelete', 'ctxDividerTop', 'ctxDividerMid', 'ctxDividerDelete'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = 'none';
  });

  updateSortIndicators();

  const menuHeight = 196;
  const x = Math.min(event.clientX, window.innerWidth - 220);
  const y = Math.min(event.clientY, window.innerHeight - menuHeight);
  els.contextMenu.style.left = x + 'px';
  els.contextMenu.style.top = y + 'px';
  els.contextMenu.classList.add('visible');
}

function handleItemContextMenu(event, path, isFolder, icon) {
  event.preventDefault();
  event.stopPropagation();
  contextItem = { path, isFolder, icon };

  // Hide background-only items
  ['ctxNew', 'ctxSortBy', 'ctxPasteBg', 'ctxDividerBg'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = 'none';
  });

  // Show item-specific options
  ['ctxOpen', 'ctxDownload', 'ctxRename', 'ctxCopy', 'ctxCut',
   'ctxZip', 'ctxDelete', 'ctxDividerTop', 'ctxDividerMid', 'ctxDividerDelete'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = 'flex';
  });
  ['ctxDividerTop', 'ctxDividerMid', 'ctxDividerDelete'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = 'block';
  });

  // Conditionals
  document.getElementById('ctxPreview').style.display = isFolder ? 'none' : 'flex';
  document.getElementById('ctxUnzip').style.display = icon === 'zip' ? 'flex' : 'none';
  document.getElementById('ctxPaste').style.display = clipboard.items.length > 0 ? 'flex' : 'none';

  // Position menu
  const x = Math.min(event.clientX, window.innerWidth - 220);
  const y = Math.min(event.clientY, window.innerHeight - 340);
