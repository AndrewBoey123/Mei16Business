// Upload
function setupDragDrop() {
  const contentArea = document.getElementById('contentArea');
  
  ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
    contentArea.addEventListener(eventName, preventDefaults, false);
  });

  function preventDefaults(e) {
    e.preventDefault();
    e.stopPropagation();
  }

  ['dragenter', 'dragover'].forEach(eventName => {
    contentArea.addEventListener(eventName, () => {
      els.dropZone.classList.add('active');
    }, false);
  });

  ['dragleave', 'drop'].forEach(eventName => {
    contentArea.addEventListener(eventName, (e) => {
      if (eventName === 'dragleave' && e.target !== contentArea) return;
      els.dropZone.classList.remove('active');
    }, false);
  });

  contentArea.addEventListener('drop', async (e) => {
    const items = e.dataTransfer.items;
    if (!items || items.length === 0) return;
    
    showToast('Scanning dropped items...', 'info');
    
    // Collect all files recursively from folders
    const allFiles = [];
    
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      const entry = item.webkitGetAsEntry ? item.webkitGetAsEntry() : null;
      
      if (entry) {
        // Start with empty path, traverseEntry will build the full path
        await traverseEntry(entry, '', allFiles);
      } else {
        // Fallback to File object
        const file = item.getAsFile();
        if (file) allFiles.push(file);
      }
    }
    
    if (allFiles.length > 0) {
      showToast(`Uploading ${allFiles.length} file(s)...`, 'info');
      uploadFiles(allFiles);
    } else {
      showToast('No files found to upload', 'error');
    }
  }, false);
}

// Recursively traverse directory entry
// currentPath is the path up to this point (e.g., "" or "Mei16_Sock/" or "Mei16_Sock/subfolder/")
async function traverseEntry(entry, currentPath, fileList) {
  if (entry.isFile) {
    return new Promise((resolve) => {
      entry.file((file) => {
        // Full path = current path + file name
        const fullPath = currentPath + file.name;
        Object.defineProperty(file, 'webkitRelativePath', {
          value: fullPath,
          writable: false
        });
        fileList.push(file);
        resolve();
      }, () => resolve());
    });
  } else if (entry.isDirectory) {
    const dirReader = entry.createReader();
    return new Promise((resolve) => {
      const readEntries = () => {
        dirReader.readEntries(async (entries) => {
          if (entries.length === 0) {
            resolve();
            return;
          }
          
          // For children, the path includes this directory name
          const childPath = currentPath + entry.name + '/';
          const promises = entries.map(childEntry => 
            traverseEntry(childEntry, childPath, fileList)
          );
          await Promise.all(promises);
          
          // Continue reading (Chrome returns entries in batches)
          readEntries();
        }, () => resolve());
      };
      readEntries();
    });
  }
}

// Desktop File Picker using File System Access API (Modern Browsers)
async function openDesktopFilePicker() {
  // Check if API is supported
  if (!('showOpenFilePicker' in window)) {
    showToast('Desktop picker not supported in this browser. Use the drag & drop area instead.', 'error');
    return;
  }
  
  try {
    // Open system file picker
    const fileHandles = await window.showOpenFilePicker({
      multiple: true,
      types: [
        { description: 'All Files', accept: { '*/*': [] } }
      ]
    });
    
    if (fileHandles.length === 0) return;
    
    // Convert FileSystemFileHandle to File objects
    const files = [];
    for (const handle of fileHandles) {
      const file = await handle.getFile();
      files.push(file);
    }
    
    // Upload the selected files
    if (files.length > 0) {
      showToast(`Selected ${files.length} file(s) from desktop`, 'success');
      uploadFiles(files);
      closeModal('uploadModal');
    }
  } catch (err) {
    if (err.name !== 'AbortError') {
      console.error('Desktop picker error:', err);
      showToast('Error accessing desktop files: ' + err.message, 'error');
    }
  }
}

function handleFileSelect(files) {
