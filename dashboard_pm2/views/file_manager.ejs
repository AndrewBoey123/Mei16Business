async function uploadFiles(files) {
  const progressEl    = document.getElementById('uploadProgress');
  const fillEl        = document.getElementById('uploadFill');
  const percentEl     = document.getElementById('uploadPercent');
  const bytesEl       = document.getElementById('uploadBytes');
  const currentFileEl = document.getElementById('uploadCurrentFile');

  // Total declared bytes from client File objects
  const totalDeclared = Array.from(files).reduce((s, f) => s + f.size, 0);

  progressEl.classList.add('visible');
  if (bytesEl) bytesEl.textContent = '';
  if (currentFileEl) {
    const names = Array.from(files).map(f => f.name);
    currentFileEl.textContent = names.length === 1 ? `↑ ${names[0]}` : `↑ ${names.length} files`;
  }

  const formData = new FormData();
  formData.append('dir', currentPath);
  for (let i = 0; i < files.length; i++) {
    const file = files[i];
    // Check if file has relative path (from folder drag)
    const relativePath = file.webkitRelativePath || '';
    if (relativePath) {
      // Create a new File object with the path as the name
      // This allows multer to receive the full path like "Mei16_Sock/file.js"
      const newFile = new File([file], relativePath, { type: file.type });
      formData.append('files', newFile);
    } else {
      formData.append('files', file);
    }
  }

  try {
    const xhr = new XMLHttpRequest();

    xhr.upload.addEventListener('progress', (e) => {
      if (e.lengthComputable) {
        const percent = Math.round((e.loaded / e.total) * 100);
        fillEl.style.width = percent + '%';
        percentEl.textContent = percent + '%';
        if (bytesEl) bytesEl.textContent = `${formatBytes(e.loaded)} / ${formatBytes(e.total)}`;
      }
    });

    xhr.addEventListener('load', () => {
      progressEl.classList.remove('visible');
      if (currentFileEl) currentFileEl.textContent = '';
      if (bytesEl) bytesEl.textContent = '';

      if (xhr.status === 200) {
        const data = JSON.parse(xhr.responseText);
        if (data.ok) {
          const v = data.verification;
          if (v) {
            if (v.verified) {
              showToast(`Upload verified: ${formatBytes(v.totalSavedBytes)} — ${data.files.length} file${data.files.length !== 1 ? 's' : ''}`, 'success');
            } else {
              // Show general mismatch or per-file mismatches
              const failed = data.files.filter(f => !f.verified);
              if (failed.length) {
                failed.forEach(f => {
                  showToast(`⚠️ Upload mismatch: ${f.name} — received ${formatBytes(f.savedSize)}, expected ${formatBytes(f.declaredSize)}`, 'warning');
                });
              } else {
                showToast(`⚠️ Upload mismatch: received ${formatBytes(v.totalSavedBytes)}, expected ${formatBytes(v.totalDeclaredBytes)}`, 'warning');
              }
            }
          } else {
            showToast(data.message, 'success');
          }
          loadFiles();
        } else {
          showToast('Upload failed: ' + data.error, 'error');
        }
      } else {
        showToast('Upload failed', 'error');
      }
    });

    xhr.addEventListener('error', () => {
      progressEl.classList.remove('visible');
      if (currentFileEl) currentFileEl.textContent = '';
      showToast('Upload failed', 'error');
    });

    xhr.open('POST', '/fileman/api/upload');
    xhr.send(formData);
  } catch (err) {
    progressEl.classList.remove('visible');
    showToast('Upload error: ' + err.message, 'error');
  }
}

// Search
async function handleSearch(query) {
  if (!query.trim()) {
    isSearching = false;
    loadFiles();
    return;
  }

  isSearching = true;
  try {
    showLoading(true);
    const res = await fetch('/fileman/api/search?dir=' + encodeURIComponent(currentPath) + '&q=' + encodeURIComponent(query));
    const data = await res.json();
    
    if (data.ok) {
      currentItems = data.results.map(r => ({
        ...r,
        type: r.isFolder ? 'folder' : 'file',
        icon: r.icon
      }));
      renderFiles();
      els.itemCount.textContent = `${data.count} results`;
    }
  } catch (err) {
    showToast('Search error: ' + err.message, 'error');
  } finally {
    showLoading(false);
  }
}

// Keyboard Shortcuts
function setupKeyboard() {
  document.addEventListener('keydown', (e) => {
    // Delete key
    if (e.key === 'Delete' && selectedItems.size > 0) {
      deleteSelected();
    }
    
    // Ctrl+A - Select all
    if ((e.ctrlKey || e.metaKey) && e.key === 'a') {
      e.preventDefault();
      currentItems.forEach(item => selectedItems.add(item.path));
      updateSelectionUI();
    }
    
    // Ctrl+C - Copy selected files
    if ((e.ctrlKey || e.metaKey) && e.key === 'c' && selectedItems.size > 0) {
      e.preventDefault();
      const items = Array.from(selectedItems).map(path => ({
        path,
        isFolder: currentItems.find(i => i.path === path)?.type === 'folder'
      }));
      clipboard = { items, action: 'copy' };
      clipboardTimestamp = Date.now(); // Record when we copied
      showToast(`${items.length} item(s) copied to clipboard`, 'success');
    }
    
    // Ctrl+X - Cut selected files  
    if ((e.ctrlKey || e.metaKey) && e.key === 'x' && selectedItems.size > 0) {
      e.preventDefault();
      const items = Array.from(selectedItems).map(path => ({
        path,
        isFolder: currentItems.find(i => i.path === path)?.type === 'folder'
      }));
      clipboard = { items, action: 'cut' };
      clipboardTimestamp = Date.now(); // Record when we cut
      showToast(`${items.length} item(s) cut to clipboard`, 'success');
    }
    
    // Escape - Close modals/context menu
    if (e.key === 'Escape') {
      els.contextMenu.classList.remove('visible');
      document.querySelectorAll('.fm-modal-overlay').forEach(el => el.classList.remove('visible'));
    }
    
    // F5 - Refresh
    if (e.key === 'F5') {
      e.preventDefault();
      refresh();
    }
    
    // Ctrl+S - Save (when in edit mode)
    if (isEditMode && (e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      saveFile();
    }
    
    // Ctrl+V - Paste from OS clipboard
    if ((e.ctrlKey || e.metaKey) && e.key === 'v') {
      // Don't prevent default immediately - let the paste event handler catch it
      // The paste event has access to e.clipboardData which works better
    }
  });
}

// Global variables for clipboard
let pendingPaste = null;
let clipboardTimestamp = 0; // When internal clipboard was last updated

async function pasteItems() {
  if (clipboard.items.length === 0) return;

  const isCopy = clipboard.action === 'copy';
  
  // Check for conflicts for both copy and move operations
  try {
    showToast('Checking for conflicts...', 'info');
    const res = await fetch('/fileman/api/check-conflicts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: clipboard.items,
        targetDir: currentPath
      })
    });
    const data = await res.json();

    if (data.ok && data.conflicts.length > 0) {
      // Show conflict modal
      showConflictModal(data.conflicts, isCopy);
      pendingPaste = { items: clipboard.items, isCopy };
    } else {
      // No conflicts, proceed directly with default resolution
      await executePaste(isCopy ? 'rename' : 'overwrite');
    }
  } catch (err) {
    showToast('Error checking conflicts: ' + err.message, 'error');
    // Fall back to direct paste
    await executePaste(isCopy ? 'rename' : 'overwrite');
  }
}

function showConflictModal(conflicts, isCopy) {
  const listEl = document.getElementById('conflictList');
  const actionText = isCopy ? 'copy' : 'move';
  
  // Update modal title based on action
  const titleEl = document.querySelector('#conflictModal .fm-modal-title');
  if (titleEl) {
    titleEl.innerHTML = `<i class="fa fa-exclamation-triangle" style="color: #f0ad4e;"></i> ${isCopy ? 'Copy' : 'Move'} Conflict`;
  }
  
  listEl.innerHTML = conflicts.map(c => `
    <div style="padding: 8px; border-bottom: 1px solid var(--fm-border); display: flex; justify-content: space-between; align-items: center;">
      <span style="font-weight: 500;">${escapeHtml(c.name)}</span>
      <span style="font-size: 12px; color: var(--fm-text-muted);">${c.isFolder ? 'Folder' : formatSize(c.existingSize)}</span>
    </div>
  `).join('');
  
  document.getElementById('conflictModal').classList.add('visible');
}

async function resolveConflicts(resolution) {
  closeModal('conflictModal');
  
  if (!pendingPaste) return;
  
  await executePaste(resolution);
  pendingPaste = null;
}

async function executePaste(conflictResolution) {
  const isCopy = clipboard.action === 'copy';
  const endpoint = isCopy ? '/fileman/api/copy' : '/fileman/api/move';
  const totalItems = clipboard.items.length;

  // Show copy progress widget
  showCopyProgress({ state: 'copying', total: totalItems, action: clipboard.action });

  try {
    const body = {
      items: clipboard.items,
      targetDir: currentPath
    };
    
    // Only add conflictResolution for copy operations
    if (isCopy) {
      body.conflictResolution = conflictResolution;
    }
    
    const res = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const data = await res.json();

    if (data.ok) {
      showCopyProgress({ state: 'done', data, action: clipboard.action });

      if (!isCopy) {
        clipboard = { items: [], action: null };
      }

      loadFiles();
      loadFolderTree();
    } else {
      showCopyProgress({ state: 'hide' });
      throw new Error(data.error);
    }
  } catch (err) {
    showCopyProgress({ state: 'hide' });
    showToast('Error: ' + err.message, 'error');
  }
}

// Mobile Sidebar
function toggleSidebar() {
  els.sidebar.classList.toggle('open');
  els.sidebarOverlay.classList.toggle('visible');
}

// Toast Notifications
function showToast(message, type = 'info') {
  const container = document.getElementById('toastContainer');
  const toast = document.createElement('div');
  toast.className = `fm-toast ${type}`;
  
  const icon = type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle';
  toast.innerHTML = `<i class="fa ${icon}"></i> <span>${escapeHtml(message)}</span>`;
  
  container.appendChild(toast);
  
  setTimeout(() => {
    toast.style.opacity = '0';
    toast.style.transform = 'translateX(100%)';
    setTimeout(() => toast.remove(), 300);
  }, 4000);
}

// Loading State
function showLoading(show) {
  if (show) {
    els.fileGrid.style.opacity = '0.5';
    els.fileList.style.opacity = '0.5';
  } else {
    els.fileGrid.style.opacity = '1';
    els.fileList.style.opacity = '1';
  }
}

// Status Update
function updateStatus() {
  const folderCount = currentItems.filter(i => i.type === 'folder').length;
  const fileCount = currentItems.filter(i => i.type === 'file').length;
  
  let text = '';
  if (folderCount > 0) text += `${folderCount} folder${folderCount > 1 ? 's' : ''}`;
  if (folderCount > 0 && fileCount > 0) text += ', ';
  if (fileCount > 0) text += `${fileCount} file${fileCount > 1 ? 's' : ''}`;
  if (text === '') text = '0 items';
  
  els.itemCount.textContent = text;
}

// Helpers
function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function formatSize(bytes) {
  if (bytes === 0) return '0 B';
  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(bytes) / Math.log(1024));
  return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
}

function formatDate(dateStr) {
  const d = new Date(dateStr);
  return d.toLocaleString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit'
  });
}

// Clipboard Paste handler (Ctrl+V)
// Smart detection: Uses internal clipboard if copied recently (within 30 seconds)
function setupClipboardPaste() {
  document.addEventListener('paste', (e) => {
    // Don't intercept paste inside text inputs, textareas, or code editors
    const tag = e.target.tagName.toLowerCase();
    if (tag === 'input' || tag === 'textarea' || e.target.isContentEditable) return;
    if (e.target.closest('.CodeMirror')) return;

    const cd = e.clipboardData || window.clipboardData;
    if (!cd) return;

    const now = Date.now();
    const internalClipboardAge = now - clipboardTimestamp;
    const hasInternalClipboard = clipboard.items.length > 0;
    const hasOSFiles = cd.files && cd.files.length > 0;
    const hasScreenshot = Array.from(cd.items || []).some(it => it.kind === 'file' && it.type.startsWith('image/'));

    // If internal clipboard was used within last 30 seconds, prefer it
    if (hasInternalClipboard && internalClipboardAge < 30000) {
      e.preventDefault();
      pasteItems();
      return;
    }

    // ── Case 1: Files copied from OS Explorer / Finder ──
    if (hasOSFiles) {
      e.preventDefault();
      const allFiles = Array.from(cd.files);
      
      // Filter out folders (files with size 0 and no type are likely folders)
      const files = allFiles.filter(f => f.size > 0 || f.type);
      const folders = allFiles.filter(f => f.size === 0 && !f.type);
      
      if (folders.length > 0) {
        showToast(`⚠️ ${folders.length} folder(s) skipped. Folders cannot be pasted - use Zip or Drag & Drop instead.`, 'warning');
      }
      
      if (files.length > 0) {
        showToast(`Uploading ${files.length} file(s) from PC...`, 'info');
        uploadFiles(files);
      }
      return;
    }

    // ── Case 2: Image data (screenshot, snipping tool, etc.) ──
    if (hasScreenshot) {
      const items = Array.from(cd.items || []);
      const imageItem = items.find(it => it.kind === 'file' && it.type.startsWith('image/'));
      if (imageItem) {
        e.preventDefault();
        const blob = imageItem.getAsFile();
        if (!blob) return;

        // Name the file: screenshot_YYYYMMDD_HHmmss.png
        const pad = n => String(n).padStart(2, '0');
        const name = `screenshot_${now.getFullYear()}${pad(new Date().getMonth()+1)}${pad(new Date().getDate())}_${pad(new Date().getHours())}${pad(new Date().getMinutes())}${pad(new Date().getSeconds())}.png`;
        const file = new File([blob], name, { type: blob.type });

        showToast(`Uploading screenshot...`, 'info');
        uploadFiles([file]);
      }
      return;
    }

    // ── Case 3: Internal clipboard (older than 30 seconds) ──
    if (hasInternalClipboard) {
      e.preventDefault();
      pasteItems();
    }
  });
}

// Initialize on load
document.addEventListener('DOMContentLoaded', init);
</script>

