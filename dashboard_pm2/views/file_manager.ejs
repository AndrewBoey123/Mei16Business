// Preview
async function previewFile(path, startInEditMode = false) {
  try {
    const res = await fetch('/fileman/api/preview?path=' + encodeURIComponent(path));
    const data = await res.json();

    if (!data.ok) throw new Error(data.error);

    currentPreviewItem = { path, content: data.content, name: data.name };
    originalContent = data.content || '';
    isEditMode = false;
    currentFileLanguage = getLanguageFromFilename(data.name || path);

    document.getElementById('previewTitle').innerHTML = escapeHtml(data.name || 'Preview');

    if (data.type === 'image') {
      document.getElementById('previewContent').innerHTML = `<img src="${data.data}" alt="Preview" style="max-width:100%; max-height:70vh; object-fit:contain;">`;
    } else {
      isEditMode = true;
      renderEditor(originalContent, currentFileLanguage);
    }
    document.getElementById('previewModal').classList.add('visible');
  } catch (err) {
    showToast('Cannot preview: ' + err.message, 'error');
