  /* ========================================
     SYNTAX HIGHLIGHTING & EDITOR STYLES
     ======================================== */

  /* Code Preview with Line Numbers */
  .fm-code-preview {
    display: flex;
    background: #1e1e1e;
    border-radius: var(--fm-radius);
    overflow: hidden;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .fm-line-numbers {
    background: #252526;
    color: #858585;
