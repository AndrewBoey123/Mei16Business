  .fm-verify-list .fm-vi-ok   { color: #28a745; }
  .fm-verify-list .fm-vi-fail { color: #dc3545; }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    .fm-sidebar {
      position: fixed;
      left: 0;
      top: 60px;
      bottom: 0;
      z-index: 500;
      transform: translateX(-100%);
    }

    .fm-sidebar.open {
      transform: translateX(0);
    }

    .fm-sidebar-overlay {
      position: fixed;
      inset: 60px 0 0 0;
      background: rgba(0,0,0,0.5);
      z-index: 400;
      display: none;
    }

    .fm-sidebar-overlay.visible {
      display: block;
    }

    .fm-toolbar {
      padding: 8px 12px;
    }

    .fm-toolbar-group:not(.mobile-visible) {
      display: none;
    }

    .fm-search {
      max-width: none;
      width: 100%;
      order: -1;
    }

    .fm-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .fm-grid-icon {
      width: 48px;
      height: 48px;
      font-size: 28px;
    }

    .fm-list-header {
      display: none;
    }

    .fm-list-item {
      grid-template-columns: 40px 1fr auto;
      padding: 12px;
    }

    .fm-list-size, .fm-list-date {
      display: none;
    }

    .fm-list-actions {
      opacity: 1;
    }

    .fm-breadcrumb {
      padding: 8px 12px;
    }

    .fm-statusbar {
      padding: 8px 12px;
      font-size: 11px;
    }

    .fm-modal {
      margin: 10px;
      max-height: calc(100vh - 20px);
    }
  }

  @media (max-width: 480px) {
    .fm-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Mobile Menu Toggle */
  .fm-mobile-menu-btn {
    display: none;
  }

  @media (max-width: 768px) {
    .fm-mobile-menu-btn {
      display: inline-flex;
    }
  }

  /* Selection Rectangle (for drag-select) */
  .fm-selection-rect {
    position: absolute;
    border: 1px dashed var(--fm-primary);
    background: rgba(67, 97, 238, 0.1);
    pointer-events: none;
    z-index: 50;
    display: none;
  }

  /* Loading Spinner */
  .fm-spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid var(--fm-border);
    border-top-color: var(--fm-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
