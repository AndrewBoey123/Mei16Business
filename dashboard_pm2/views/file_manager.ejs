  }

  /* CodeMirror editor styles */
  #cmEditorContainer {
    flex: 1;
    min-height: 0;
    height: 60vh;
    overflow: auto;
  }

  .CodeMirror {
    height: 100%;
    font-size: 13px;
    font-family: 'Monaco', 'Consolas', 'Courier New', monospace;
    line-height: 1.6;
  }

  /* Theme Adaptations for Prism */
  [data-theme="night"] .fm-code-preview {
    background: #0d1117;
  }

  [data-theme="night"] .fm-line-numbers {
    background: #161b22;
    border-color: #30363d;
  }

  /* Editor Toggle Button States */
  .fm-btn.editing {
    background: var(--fm-primary);
    color: white;
  }

  /* Save/Cancel Button Styles */
  .fm-btn-success {
    background: var(--fm-success);
    color: white;
    border-color: var(--fm-success);
  }

  .fm-btn-success:hover {
    background: #218838;
    border-color: #1e7e34;
  }

  /* Unsaved Changes Indicator */
  .fm-unsaved-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--fm-warning);
    font-size: 12px;
    margin-left: 10px;
  }

  .fm-unsaved-indicator::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--fm-warning);
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* Responsive Editor */
  @media (max-width: 768px) {
    .fm-code-preview {
      flex-direction: column;
    }

    .fm-line-numbers {
      display: none;
    }

