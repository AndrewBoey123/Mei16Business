<style>
  /* ========================================
     FILE MANAGER PRO - MODERN RESPONSIVE UI
     ======================================== */

  :root {
    --fm-primary: #4361ee;
    --fm-primary-hover: #3a56d4;
    --fm-danger: #dc3545;
    --fm-success: #28a745;
    --fm-warning: #ffc107;
    --fm-bg: #f8f9fa;
    --fm-card-bg: #ffffff;
    --fm-border: #e0e0e0;
    --fm-text: #333333;
    --fm-text-muted: #6c757d;
    --fm-hover: #f0f0f0;
    --fm-selected: #e3f2fd;
    --fm-selected-border: #4361ee;
    --fm-shadow: 0 2px 8px rgba(0,0,0,0.08);
    --fm-radius: 8px;
  }

  [data-theme="night"] {
    --fm-bg: #0d1117;
    --fm-card-bg: #161b22;
    --fm-border: #30363d;
    --fm-text: #c9d1d9;
    --fm-text-muted: #8b949e;
    --fm-hover: #21262d;
    --fm-selected: #1f2937;
    --fm-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }

  [data-theme="blue"] {
    --fm-bg: #edf2fb;
    --fm-card-bg: #f5f8ff;
    --fm-border: #c4d6f0;
    --fm-text: #2b3e6b;
    --fm-text-muted: #5b7ab8;
    --fm-hover: #dce8f8;
    --fm-selected: #cfe0f9;
  }

  [data-theme="teal"] {
    --fm-bg: #e8f5f4;
    --fm-card-bg: #f0faf9;
    --fm-border: #a5d5d1;
    --fm-text: #1c3d3a;
    --fm-text-muted: #3a8a84;
    --fm-hover: #c8e9e6;
    --fm-selected: #b8e3df;
  }

  [data-theme="sand"] {
    --fm-bg: #f3ece0;
    --fm-card-bg: #fdf6eb;
    --fm-border: #d4c0a0;
    --fm-text: #48352a;
    --fm-text-muted: #8a6040;
    --fm-hover: #e6d6be;
    --fm-selected: #d9c4a0;
  }

  /* Main Container */
  .fileman-container {
    height: calc(100vh - 60px);
    display: flex;
    flex-direction: column;
    background: var(--fm-bg);
    color: var(--fm-text);
    overflow: hidden;
  }

  /* Toolbar */
  .fm-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: var(--fm-card-bg);
    border-bottom: 1px solid var(--fm-border);
    flex-wrap: wrap;
  }

  .fm-toolbar-group {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .fm-toolbar-divider {
    width: 1px;
    height: 24px;
    background: var(--fm-border);
    margin: 0 4px;
  }

  .fm-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid var(--fm-border);
    background: var(--fm-card-bg);
    color: var(--fm-text);
    border-radius: var(--fm-radius);
    cursor: pointer;
    font-size: 13px;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .fm-btn:hover:not(:disabled) {
    background: var(--fm-hover);
    border-color: var(--fm-primary);
  }

  .fm-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .fm-btn-active {
    background: var(--fm-primary);
    color: white;
    border-color: var(--fm-primary);
  }

  .fm-btn-primary {
    background: var(--fm-primary);
    color: white;
    border-color: var(--fm-primary);
  }

  .fm-btn-primary:hover:not(:disabled) {
    background: var(--fm-primary-hover);
  }

  .fm-btn-danger {
    color: var(--fm-danger);
    border-color: var(--fm-danger);
  }

  .fm-btn-danger:hover:not(:disabled) {
    background: var(--fm-danger);
    color: white;
  }

  .fm-btn-icon {
    padding: 8px;
    font-size: 14px;
  }

  /* Breadcrumb */
  .fm-breadcrumb {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 16px;
    background: var(--fm-card-bg);
    border-bottom: 1px solid var(--fm-border);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .fm-breadcrumb::-webkit-scrollbar {
    display: none;
  }

  .fm-breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 13px;
    white-space: nowrap;
    color: var(--fm-primary);
  }

  .fm-breadcrumb-item:hover {
    background: var(--fm-hover);
  }

  .fm-breadcrumb-separator {
    color: var(--fm-text-muted);
    font-size: 12px;
  }

  .fm-breadcrumb-current {
    color: var(--fm-text);
    font-weight: 500;
  }

  /* Search Bar */
  .fm-search {
    position: relative;
    flex: 1;
    max-width: 300px;
  }

  .fm-search input {
    width: 100%;
    padding: 8px 12px 8px 32px;
    border: 1px solid var(--fm-border);
    border-radius: var(--fm-radius);
    background: var(--fm-card-bg);
    color: var(--fm-text);
    font-size: 13px;
  }

  .fm-search i {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--fm-text-muted);
    font-size: 12px;
  }

  .fm-search input:focus {
    outline: none;
    border-color: var(--fm-primary);
  }

  /* Main Content Area */
  .fm-main {
    flex: 1;
    display: flex;
    overflow: hidden;
  }

  /* Sidebar (Tree) */
  .fm-sidebar {
    width: 240px;
    background: var(--fm-card-bg);
    border-right: 1px solid var(--fm-border);
    overflow-y: auto;
    transition: transform 0.3s;
  }

  .fm-sidebar-header {
    padding: 12px 16px;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    color: var(--fm-text-muted);
    border-bottom: 1px solid var(--fm-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .fm-tree {
    padding: 8px;
  }

  .fm-tree-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 13px;
    user-select: none;
  }

  .fm-tree-item:hover {
    background: var(--fm-hover);
  }

  .fm-tree-item.active {
    background: var(--fm-selected);
    color: var(--fm-primary);
  }

  .fm-tree-item i {
    color: #ffc107;
    font-size: 14px;
    width: 16px;
    text-align: center;
  }

  .fm-tree-toggle {
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: var(--fm-text-muted);
    cursor: pointer;
  }

  .fm-tree-children {
    padding-left: 20px;
    display: none;
  }

  .fm-tree-children.expanded {
    display: block;
  }

  /* Content Area */
  .fm-content {
    flex: 1;
    overflow: auto;
    padding: 16px;
  }

  /* Drop Zone Overlay */
  .fm-drop-zone {
    position: absolute;
    inset: 0;
    background: rgba(67, 97, 238, 0.1);
    border: 3px dashed var(--fm-primary);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 100;
    pointer-events: none;
  }

  .fm-drop-zone.active {
    display: flex;
  }

  .fm-drop-zone-content {
    text-align: center;
    color: var(--fm-primary);
  }

  .fm-drop-zone-content i {
    font-size: 48px;
    margin-bottom: 16px;
  }

  /* File Grid (Icon View) */
  .fm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 16px;
  }

  .fm-grid-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px 8px;
    border-radius: var(--fm-radius);
    cursor: pointer;
    transition: all 0.15s;
    position: relative;
  }

  .fm-grid-item:hover {
    background: var(--fm-hover);
  }

  .fm-grid-item.selected {
    background: var(--fm-selected);
    outline: 2px solid var(--fm-primary);
  }

  .fm-grid-item.selected::after {
    content: '\f00c';
    font-family: 'Font Awesome 6 Free';
    font-weight: 900;
    position: absolute;
    top: 4px;
    right: 4px;
    width: 20px;
    height: 20px;
    background: var(--fm-primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
  }

  .fm-grid-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
    margin-bottom: 8px;
  }

  .fm-grid-icon img {
    max-width: 100%;
    max-height: 100%;
    object-fit: cover;
    border-radius: 4px;
  }

  .fm-grid-icon.folder {
    color: #ffc107;
  }

  .fm-grid-icon.image {
    color: #9c27b0;
  }

  .fm-grid-icon.video {
    color: #f44336;
  }

  .fm-grid-icon.audio {
    color: #2196f3;
  }

  .fm-grid-icon.pdf {
    color: #ff5722;
  }

  .fm-grid-icon.word {
    color: #2196f3;
  }

  .fm-grid-icon.excel {
    color: #4caf50;
  }

  .fm-grid-icon.powerpoint {
    color: #ff9800;
  }

  .fm-grid-icon.code {
    color: #607d8b;
  }

  .fm-grid-icon.zip {
    color: #795548;
  }

  .fm-grid-icon.text {
    color: #9e9e9e;
  }

  .fm-grid-name {
    font-size: 12px;
    text-align: center;
    word-break: break-word;
    max-width: 100%;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* File List (List View) */
  .fm-list {
    background: var(--fm-card-bg);
    border-radius: var(--fm-radius);
    box-shadow: var(--fm-shadow);
    overflow: hidden;
  }

  .fm-list-header {
    display: grid;
    grid-template-columns: 40px 1fr 120px 180px 100px;
    gap: 12px;
    padding: 12px 16px;
    background: var(--fm-hover);
    font-size: 12px;
    font-weight: 600;
    color: var(--fm-text-muted);
    text-transform: uppercase;
    border-bottom: 1px solid var(--fm-border);
  }

  .fm-list-item {
    display: grid;
    grid-template-columns: 40px 1fr 120px 180px 100px;
    gap: 12px;
    padding: 10px 16px;
    align-items: center;
    cursor: pointer;
    border-bottom: 1px solid var(--fm-border);
    font-size: 13px;
  }

  .fm-list-item:last-child {
    border-bottom: none;
  }

  .fm-list-item:hover {
    background: var(--fm-hover);
  }

  .fm-list-item.selected {
    background: var(--fm-selected);
  }

  .fm-list-checkbox {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fm-list-checkbox input {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .fm-list-name {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .fm-list-name i {
    font-size: 18px;
    width: 24px;
    text-align: center;
  }

  .fm-list-name i.folder {
    color: #ffc107;
  }

  .fm-list-size, .fm-list-date {
    color: var(--fm-text-muted);
  }

  .fm-list-actions {
    display: flex;
    gap: 6px;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .fm-list-item:hover .fm-list-actions,
  .fm-list-item.selected .fm-list-actions {
    opacity: 1;
  }

  .fm-list-actions button {
    padding: 4px 8px;
    font-size: 11px;
    border: none;
    background: transparent;
    color: var(--fm-text-muted);
    cursor: pointer;
    border-radius: 4px;
  }

  .fm-list-actions button:hover {
    background: var(--fm-hover);
    color: var(--fm-primary);
  }

  /* Empty State */
  .fm-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    color: var(--fm-text-muted);
    text-align: center;
  }

  .fm-empty i {
    font-size: 64px;
    margin-bottom: 16px;
    opacity: 0.5;
  }

  .fm-empty h3 {
    font-size: 18px;
    margin-bottom: 8px;
    color: var(--fm-text);
  }

  /* Status Bar */
  .fm-statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background: var(--fm-card-bg);
    border-top: 1px solid var(--fm-border);
    font-size: 12px;
    color: var(--fm-text-muted);
  }

  .fm-statusbar-left, .fm-statusbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Context Menu */
  .fm-context-menu {
    position: fixed;
    background: var(--fm-card-bg);
    border: 1px solid var(--fm-border);
    border-radius: var(--fm-radius);
    box-shadow: var(--fm-shadow);
    padding: 6px 0;
    min-width: 180px;
    z-index: 1000;
    display: none;
  }

  .fm-context-menu.visible {
    display: block;
  }

  .fm-context-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    cursor: pointer;
    font-size: 13px;
    color: var(--fm-text);
  }

  .fm-context-item:hover {
    background: var(--fm-hover);
  }

  .fm-context-item.danger {
    color: var(--fm-danger);
  }

  .fm-context-divider {
    height: 1px;
    background: var(--fm-border);
    margin: 6px 0;
  }

  /* Submenu (flyout) */
  .fm-has-submenu {
    position: relative;
    justify-content: space-between;
  }

  .fm-submenu-arrow {
    margin-left: auto;
    font-size: 10px;
    color: var(--fm-text-muted);
  }

  .fm-submenu {
    display: none;
    position: absolute;
    left: 100%;
    top: -6px;
    background: var(--fm-card-bg);
    border: 1px solid var(--fm-border);
    border-radius: var(--fm-radius);
    box-shadow: var(--fm-shadow);
    padding: 6px 0;
    min-width: 200px;
    z-index: 1001;
  }

  .fm-has-submenu:hover > .fm-submenu {
    display: block;
  }

  /* Active sort indicator */
  .fm-context-item.sort-active {
    font-weight: 600;
    color: var(--fm-primary);
  }

  /* Modal */
  .fm-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 20px;
  }

  .fm-modal-overlay.visible {
    display: flex;
  }

  .fm-modal {
    background: var(--fm-card-bg);
    border-radius: var(--fm-radius);
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    max-width: 500px;
    width: 100%;
    max-height: 90vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .fm-modal-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--fm-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .fm-modal-title {
    font-size: 16px;
    font-weight: 600;
  }

  .fm-modal-close {
    background: none;
    border: none;
    font-size: 20px;
    color: var(--fm-text-muted);
    cursor: pointer;
    padding: 4px;
  }

  .fm-modal-body {
    padding: 20px;
    overflow-y: auto;
  }

  .fm-modal-footer {
    padding: 16px 20px;
    border-top: 1px solid var(--fm-border);
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }

  /* Preview Modal */
  .fm-preview-modal .fm-modal {
    max-width: 92vw;
    width: 92vw;
    max-height: 92vh;
    height: 92vh;
  }

  .fm-preview-content {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 0;
    background: var(--fm-bg);
    overflow: hidden;
  }

  /* Editor fills the full content area */
  .fm-preview-content .fm-editor-container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .fm-preview-content .fm-editor-textarea {
    flex: 1;
    min-height: 0;
    height: 100%;
    resize: none;
  }

  .fm-preview-content img {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
  }

  .fm-preview-content pre {
    width: 100%;
    flex: 1;
    min-height: 0;
    overflow: auto;
    background: var(--fm-bg);
    padding: 16px;
    margin: 0;
    font-family: 'Monaco', 'Consolas', monospace;
    font-size: 13px;
    line-height: 1.5;
  }

  /* Toast Notifications */
  .fm-toast-container {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 3000;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .fm-toast {
    background: var(--fm-card-bg);
    border: 1px solid var(--fm-border);
    border-radius: var(--fm-radius);
    box-shadow: var(--fm-shadow);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 280px;
    animation: slideIn 0.3s ease;
  }

  .fm-toast.success {
    border-left: 3px solid var(--fm-success);
  }

  .fm-toast.error {
    border-left: 3px solid var(--fm-danger);
  }

  .fm-toast.warning {
    border-left: 3px solid var(--fm-warning);
  }

  @keyframes slideIn {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  /* Upload Progress */
  .fm-upload-progress {
    position: fixed;
    bottom: 80px;
    right: 20px;
    background: var(--fm-card-bg);
    border: 1px solid var(--fm-border);
    border-radius: var(--fm-radius);
    box-shadow: var(--fm-shadow);
    padding: 16px;
    min-width: 300px;
    z-index: 2500;
    display: none;
  }

  .fm-upload-progress.visible {
    display: block;
  }

  .fm-upload-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 13px;
  }

  .fm-upload-bar {
    height: 4px;
    background: var(--fm-hover);
    border-radius: 2px;
    overflow: hidden;
  }

