function renderCodePreview(content, language) {
  const contentEl = document.getElementById('previewContent');
  const lines = content.split('\n');
  const lineNumbers = lines.map((_, i) => i + 1).join('\n');
  
  const langClass = language === 'text' ? '' : `class="language-${language}"`;
  
  contentEl.innerHTML = `
    <div class="fm-code-preview">
      <div class="fm-line-numbers">${escapeHtml(lineNumbers)}</div>
      <div class="fm-code-content">
        <pre><code ${langClass}>${escapeHtml(content)}</code></pre>
      </div>
    </div>
  `;
  
  // Apply syntax highlighting
  if (language !== 'text' && window.Prism) {
    Prism.highlightAllUnder(contentEl);
  }
}

function renderEditor(content, language) {
  const contentEl = document.getElementById('previewContent');
  const ext = currentPreviewItem.name ? currentPreviewItem.name.substring(currentPreviewItem.name.lastIndexOf('.')) : '';

  // Destroy any existing CodeMirror instance
  if (cmEditor) {
    try { cmEditor.toTextArea(); } catch(e) {}
    cmEditor = null;
  }

  contentEl.innerHTML = `
    <div class="fm-editor-container">
      <div class="fm-editor-toolbar">
        <button class="fm-btn fm-btn-success" onclick="saveFile()">
          <i class="fa fa-save"></i> Save
        </button>
        <button class="fm-btn" onclick="closeModal('previewModal')">
          <i class="fa fa-times"></i> Cancel
        </button>
        <span class="fm-unsaved-indicator" id="unsavedIndicator" style="display:none;">
          Unsaved changes
        </span>
        <span class="fm-editor-info">
          ${escapeHtml(ext)} • ${content.length} chars • ${content.split('\\n').length} lines
        </span>
      </div>
      <div id="cmEditorContainer"></div>
    </div>
  `;

  setTimeout(() => {
    const container = document.getElementById('cmEditorContainer');
    if (!container || typeof CodeMirror === 'undefined') return;
    const mode = cmModeMap[language] !== undefined ? cmModeMap[language] : null;
    cmEditor = CodeMirror(container, {
      value: content,
      mode: mode,
      theme: 'dracula',
      lineNumbers: true,
      lineWrapping: true,
