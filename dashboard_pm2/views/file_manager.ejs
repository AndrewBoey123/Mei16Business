async function contextPaste() {
  els.contextMenu.classList.remove('visible');

  // Internal clipboard (copy/cut within file manager) takes priority
  if (clipboard.items.length > 0) {
    pasteItems();
    return;
  }

  // Try to read screenshot/image from OS clipboard via Clipboard API (Chrome/Edge with permission)
  if (navigator.clipboard && navigator.clipboard.read) {
    try {
      const clipItems = await navigator.clipboard.read();
      const files = [];

      for (const item of clipItems) {
        for (const type of item.types) {
          if (type.startsWith('image/')) {
            const blob = await item.getType(type);
            const now = new Date();
            const pad = n => String(n).padStart(2, '0');
            const name = `screenshot_${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}.png`;
            files.push(new File([blob], name, { type }));
          }
        }
      }

      if (files.length > 0) {
        showToast(`Pasting ${files.length} image(s) from clipboard…`, 'info');
        uploadFiles(files);
        return;
      }
    } catch (err) {
      // Permission denied or no clipboard access — fall through to guidance
    }
  }

  // For files copied from Explorer/Finder, browsers only expose them during a real
  // Ctrl+V keypress — no button click can trigger that. Guide the user.
  showToast('To paste files from Explorer: Copy them first, then press Ctrl+V here', 'info');
}

