    height: 100%;
    background: var(--fm-primary);
    transition: width 0.3s;
  }

  /* Copy progress widget — stacks above upload widget when both visible */
  #copyProgress {
    bottom: 80px;
    right: 20px;
  }
  #copyProgress.stacked {
    bottom: 220px;
  }

  /* Indeterminate pulsing bar for "copying in progress" state */
  @keyframes fm-pulse {
    0%   { left: -40%; width: 40%; }
    60%  { left: 100%;  width: 40%; }
    100% { left: 100%;  width: 40%; }
  }
  .fm-bar-pulse {
    position: relative;
    overflow: hidden;
  }
  .fm-bar-pulse::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    background: var(--fm-primary);
    animation: fm-pulse 1.4s ease-in-out infinite;
  }

  /* Per-file verification rows */
  .fm-verify-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 12px;
  }
  .fm-verify-list li {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
    border-bottom: 1px solid var(--fm-border);
  }
