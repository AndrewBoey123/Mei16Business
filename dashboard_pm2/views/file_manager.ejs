    padding: 0 !important;
  }

  .fm-code-content code {
    font-family: 'Monaco', 'Consolas', 'Courier New', monospace;
    font-size: 13px;
    line-height: 1.6;
  }

  /* Edit Mode */
  .fm-editor-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 400px;
  }

  .fm-editor-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--fm-hover);
    border-bottom: 1px solid var(--fm-border);
    font-size: 13px;
  }

  .fm-editor-info {
    margin-left: auto;
    color: var(--fm-text-muted);
  }

  .fm-editor-textarea {
    flex: 1;
    width: 100%;
    padding: 16px;
    border: none;
    background: #1e1e1e;
    color: #d4d4d4;
    font-family: 'Monaco', 'Consolas', 'Courier New', monospace;
    font-size: 13px;
    line-height: 1.6;
    resize: none;
    outline: none;
