// Sort state
let sortField = 'name';   // 'name' | 'date' | 'size' | 'type'
let sortDir   = 'asc';    // 'asc'  | 'desc'

function applySortOrder(field, dir) {
  sortField = field;
  sortDir   = dir;
  els.contextMenu.classList.remove('visible');
  updateSortIndicators();

  const folders = currentItems.filter(i => i.type === 'folder');
  const files   = currentItems.filter(i => i.type !== 'folder');

  const compareFn = (a, b) => {
    let valA, valB;
    if (field === 'name')  { valA = a.name.toLowerCase(); valB = b.name.toLowerCase(); }
    if (field === 'date')  { valA = new Date(a.modified);  valB = new Date(b.modified); }
    if (field === 'size')  { valA = a.size || 0;           valB = b.size || 0; }
    if (field === 'type')  { valA = (a.name.split('.').pop() || '').toLowerCase(); valB = (b.name.split('.').pop() || '').toLowerCase(); }
    if (valA < valB) return dir === 'asc' ? -1 : 1;
    if (valA > valB) return dir === 'asc' ?  1 : -1;
    return 0;
  };

  // Folders always stay on top, sorted among themselves; files sorted after
  folders.sort(compareFn);
  files.sort(compareFn);
  currentItems = [...folders, ...files];
  renderFiles();
}

function updateSortIndicators() {
  const sortIds = ['sortNameAsc','sortNameDesc','sortDateDesc','sortDateAsc','sortSizeDesc','sortSizeAsc','sortType'];
  const activeMap = {
    'name-asc':  'sortNameAsc',  'name-desc':  'sortNameDesc',
    'date-desc': 'sortDateDesc', 'date-asc':   'sortDateAsc',
    'size-desc': 'sortSizeDesc', 'size-asc':   'sortSizeAsc',
    'type-asc':  'sortType'
  };
  const activeId = activeMap[`${sortField}-${sortDir}`];
  sortIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('sort-active', id === activeId);
  });
}

