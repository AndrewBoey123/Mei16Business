#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Mei WhatsApp AI Bot - Configuration Template
# Fill in your own values below
#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

# === BOT IDENTITY ===
BOT_NAME=Mei
PERSON=customer
JOB=sales

# === CONTACT PHONE NUMBERS ===
# Your bot's WhatsApp number (e.g., 60123456789)
BOT_PHONE=
# Your phone number for Boss commands (e.g., 60123456789)
BOSS_PHONE=

# Assistant boss phone numbers (comma-separated, optional)
ASST_BOSS_PHONE=

# === CHAT SETTINGS ===
INDIVIDUAL_CHATS=Yes
GROUP_ALLOWED=No
# Group names (comma-separated, only if GROUP_ALLOWED=Yes)
GROUP_NAMES=

# === CHAT HISTORY ===
# Use even numbers only
HISTORY_SHORT=10
HISTORY_LONG=20

# === TIMEZONE ===
localFormat=en-US
TimeZone=Asia/Kuala_Lumpur

# === ANALYTICS ===
ANALYTICS_LOGGING=Off

#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# AI PROVIDER API KEYS
# Get free API keys from the providers below
#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

# 1. GROQ (Recommended - Free Tier)
# Get key at: https://console.groq.com
# Supports: Text chat, Vision (images), Voice transcription
groqApi=
# Optional: Custom GROQ model (default: llama-3.3-70b-versatile)
GROQ_MODEL=moonshotai/kimi-k2-instruct-0905

# 2. Google Gemini (Free Tier)
# Get key at: https://makersuite.google.com/app/apikey
geminiApi=

# 3. OpenRouter (Free Tier Available)
# Get key at: https://openrouter.ai/keys
openrouterApi=
# Optional: Custom OpenRouter model
# OPENROUTER_MODEL=moonshotai/kimi-k2-instruct-0905

# 4. Ollama/Local (100% Free - Self Hosted)
# Install from: https://ollama.com
ollamaUrl=http://localhost:11434

# 5. Other Providers (Paid)
deepseekApi=
openaiApi=
qwenApi=
antApi=


#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# BOT BEHAVIOR
#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

# Mode: Sock
TYPE=Sock

# Auto-start bot on launch
AUTORUN=Yes

# AI Engine Selection:
# 1=GROQ, 2=Gemini, 3=OpenRouter, 4=Local, 5=DeepSeek, 6=OpenAI, 7=Qwen, 8=Anthropic
AUTO_ENGINE_CHOICE=1

#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# TIMING CONFIGURATION
#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

RESPONSE_DELAY_MIN_SEC=1
RESPONSE_DELAY_MAX_SEC=1
TYPING_DURATION_MIN_SEC=1
TYPING_DURATION_MAX_SEC=1
BOSS_NOTIFICATION_EXPIRY=
MEDIA_EXPIRY_MINUTES=
PERSONA_RELOAD_SECS=
ENV_RELOAD_SECS=

# Timeout for AI requests (milliseconds)
LLM_TIMEOUT_MS=60000

#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# WEB DASHBOARD
#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

WEBDASHBOARD_USERNAME=admin
WEBDASHBOARD_PASSWORD=password
BRAND=
USE_HTTPS=Yes
PORT=443

